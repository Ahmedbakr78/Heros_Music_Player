{
  "manifest_version": 3,
  "name": "Heros Player",
  "version": "1.1.0",
  "description": "Heros Player — full remote for YouTube Music, YouTube, Spotify & any media tab. Detect and control everything from the side panel. Free & unlimited.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Open Heros Player"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "tabCapture",
    "scripting",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; media-src 'self' blob: data:;"
  },
  "author": "Ahmed ABOBAKR",
  "homepage_url": "https://github.com/Ahmedbakr78/Heros_Music_Player"
}
